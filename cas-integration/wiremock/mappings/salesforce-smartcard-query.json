{
  "name": "Salesforce - smartcard lookup by serial",
  "request": {
    "method": "GET",
    "urlPath": "/services/data/v60.0/query",
    "headers": {
      "Authorization": {
        "equalTo": "Bearer local-test-access-token"
      }
    },
    "queryParameters": {
      "q": {
        "equalTo": "SELECT Id, Tipologia_Smartcard__c, Stato_Smartcard_Virtuale__c FROM Smartcard__c WHERE Seriale_Smart_Card__c = '109687603246' LIMIT 2"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "totalSize": 1,
      "done": true,
      "records": [
        {
          "Id": "local-test-record",
          "Tipologia_Smartcard__c": "HD Merlin",
          "Stato_Smartcard_Virtuale__c": "CRM_STATE_TEST"
        }
      ]
    }
  }
}