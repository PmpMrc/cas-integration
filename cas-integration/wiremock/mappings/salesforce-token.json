{
  "name": "Salesforce - local OAuth token",
  "request": {
    "method": "POST",
    "urlPath": "/services/oauth2/token",
    "headers": {
      "Content-Type": {
        "contains": "application/x-www-form-urlencoded"
      }
    },
    "bodyPatterns": [
      {
        "matches": "(^|.*&)grant_type=client_credentials(&.*|$)"
      },
      {
        "matches": "(^|.*&)client_id=local-test-client(&.*|$)"
      },
      {
        "matches": "(^|.*&)client_secret=local-test-secret(&.*|$)"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "access_token": "local-test-access-token",
      "instance_url": "http://localhost:9090",
      "token_type": "Bearer"
    }
  }
}